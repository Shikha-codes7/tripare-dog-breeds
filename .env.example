# Documented tunables. In this project they live in src/config.ts (compiled in),
# so no native env plumbing is needed. Change them there.
API_BASE_URL=https://dogapi.dog/api/v2   # no API key required
PAGE_SIZE=48                             # breeds per page request
STALE_AFTER_MINUTES=60                   # auto-sync on launch when cache is older
RETRY_TRIES=3                            # attempts per request
RETRY_BASE_MS=500                        # backoff: 500ms, 1s, 2s
